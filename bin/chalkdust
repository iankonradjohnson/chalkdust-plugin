#!/usr/bin/env python3
"""The hosted version's command, for the agent on the customer's machine. Standard library only.

  chalkdust login [--server URL]              save the key from your purchase, which it asks for without showing it
  chalkdust publish <folder>                  upload scenes, wait for the build, print the links, warnings and stills
  chalkdust parts <words>                     search our drawings, to use with data-part="name" in a scene
  chalkdust watch <folder>                    block until a question arrives, print it, exit (run in the background; also exits if nobody's watching)
  chalkdust stream <folder>                   stream the video itself: the first run makes it and prints its links, and each
                                              run after sends the slides added since, playing within seconds
  chalkdust stream <folder> --done            finish the streamed video, and check all of it
  chalkdust stream <folder> <question>        publish the answer in <folder>/answers/<question>/video.md as it is now: run it
                                              after each beat you add, while the viewer watches; checks come back in seconds
  chalkdust stream <folder> <question> --done  finish the streamed answer, and check all of it
  chalkdust answer <folder> <question>        upload <folder>/answers/<question>/, wait for the build, print stills
  chalkdust release <folder> <question>       show that answer in the player, once its stills look right
  chalkdust note <folder> <question> "text"   leave a one-line reply instead of an answer
  chalkdust comments <folder>                 print every comment left on the video, with its moment
  chalkdust delete <folder> --yes             permanently delete the video and everything about it from the service

<folder> holds video.md and, optionally, assets/: each slide a ## heading, a ```js cast of what's on screen, and the
script, with each action on its word, as [the server](server). An answer is the same, in answers/<question>/.
The video's id is saved in <folder>/.chalkdust.json, so publishing again updates the same video and link.
"""
import argparse, base64, getpass, json, os, shutil, socket, sys, time, urllib.error, urllib.request, webbrowser

CONFIG = os.environ.get("CHALKDUST_CONFIG") or os.path.expanduser("~/.config/chalkdust/config.json")
DEFAULT_SERVER = "https://getchalkdust.com"

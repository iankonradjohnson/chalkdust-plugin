class Unreachable(Exception):
    pass


def config():
    if not os.path.exists(CONFIG):
        path = os.path.abspath(sys.argv[0])
        sys.exit(f"Not logged in. Run this: it opens the browser to connect, and prints a code to check:\n  {path} login")
    return json.load(open(CONFIG))


def api(method, route, body=None, raw=False, timeout=120):
    cfg = config()
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(cfg["server"] + route, data=data, method=method, headers={"Authorization": "Bearer " + cfg["key"], "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            payload = r.read()
    except urllib.error.HTTPError as e:
        if e.code in (502, 503, 504):  # the proxy's answer while the service restarts: as temporary as a dropped connection
            raise Unreachable(f"Can't reach {cfg['server']}: {e.code}")
        detail = e.read().decode()[:500]
        try:
            detail = json.loads(detail).get("detail", detail)
        except ValueError:
            pass
        sys.exit(f"{e.code}: {detail}")
    except (urllib.error.URLError, socket.timeout, ConnectionError) as e:
        raise Unreachable(f"Can't reach {cfg['server']}: {e}")
    return payload if raw else json.loads(payload)


def video_id(folder):
    file = os.path.join(folder, ".chalkdust.json")
    if not os.path.exists(file):
        sys.exit(f"{folder} hasn't been published. Run: chalkdust publish {folder}")
    return json.load(open(file))["id"]


def read_sources(folder):
    """video.md and any assets, as the service takes them."""
    if not os.path.exists(os.path.join(folder, "video.md")):
        sys.exit(f"Write {os.path.join(folder, 'video.md')} first: a ## heading, a cast and a script for each slide")
    assets = os.path.join(folder, "assets")
    names = ["video.md"] + ([f"assets/{f}" for f in sorted(os.listdir(assets)) if not f.startswith(".") and os.path.isfile(os.path.join(assets, f))] if os.path.isdir(assets) else [])
    return {"files": {name: base64.b64encode(open(os.path.join(folder, name), "rb").read()).decode() for name in names}}


def wait_for_build(route):
    while True:
        try:
            status = api("GET", route)
        except Unreachable:  # the service restarting mid-build; it reports the build as failed once it's back
            time.sleep(5)
            continue
        if status["state"] != "building":
            break
        time.sleep(2)
    if status["state"] == "failed":
        sys.exit("Build failed:\n" + status.get("error", ""))
    return status


def save_stills(status, stills_route, folder):
    out = os.path.join(folder, ".chalkdust", "stills")
    shutil.rmtree(out, ignore_errors=True)  # old sheets would look like results of this build
    os.makedirs(out, exist_ok=True)
    saved = []
    for name in status.get("stills", []):
        open(os.path.join(out, name), "wb").write(api("GET", f"{stills_route}/{name}", raw=True))
        saved.append(os.path.join(out, name))
    return saved


def report(status, stills):
    for warning in status.get("warnings", []):
        print("warning:", warning)
    if not status.get("warnings"):
        print("warnings: none")
    print(f"length: {status.get('duration', 0):.0f}s")
    print("stills to check:", *stills, sep="\n  ") if stills else print("no stills")


def browser_login(server):
    """Connects this machine to a Chalkdust account in the browser. The key arrives by itself, and nobody sees or pastes it."""
    def post(route, body=None):
        req = urllib.request.Request(server + route, data=json.dumps(body or {}).encode(), method="POST", headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read())
    start = post("/api/login/start")
    print(f"Connect Chalkdust in your browser. Check it shows this code: {start['code']}")
    print(f"If no tab opened, go to: {start['url']}")
    webbrowser.open(start["url"])
    deadline = time.time() + start.get("expires_in", 600)
    while time.time() < deadline:
        try:
            status = post("/api/login/poll", {"poll": start["poll"]})
        except urllib.error.HTTPError:
            break
        if status["status"] == "done":
            return status["key"]
        time.sleep(2)
    sys.exit("That login expired before it was connected. Run chalkdust login again.")


def cmd_login(args):
    server = args.server.rstrip("/")
    key = args.key or (getpass.getpass("Key: ").strip() if getattr(args, "paste", False) else browser_login(server))
    if not key:
        sys.exit("No key entered.")
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    fd = os.open(CONFIG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump({"key": key, "server": args.server.rstrip("/")}, f)
    print("Saved.")


def cmd_publish(args):
    config()
    state_file = os.path.join(args.folder, ".chalkdust.json")
    if os.path.exists(state_file):
        state = json.load(open(state_file))
        api("PUT", f"/api/videos/{state['id']}", read_sources(args.folder))
    else:
        state = api("POST", "/api/videos", read_sources(args.folder))
        fd = os.open(state_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)  # holds the owner link
        with os.fdopen(fd, "w") as f:
            json.dump(state, f)
    route = f"/api/videos/{state['id']}"
    status = wait_for_build(route)
    report(status, save_stills(status, route + "/stills", args.folder))
    print("your link, which lets you ask questions:", state["owner_url"])
    print("link to share, watch only:", state["watch_url"])


REMIND = 180  # seconds a claimed question can sit with nothing written for it before the watcher brings it up again


def stalled(folder, after=REMIND):
    """Questions this watcher claimed that nobody answered: no DONE (release, stream --done and note leave one), and
    nothing written in their folder for a while (Ian, 2026-11-06: "why didn't you finish making those answers")."""
    answers, found = os.path.join(folder, "answers"), []
    for qid in sorted(os.listdir(answers)) if os.path.isdir(answers) else []:
        q = os.path.join(answers, qid)
        if not os.path.exists(os.path.join(q, "question.json")) or os.path.exists(os.path.join(q, "DONE")):
            continue
        newest = max([os.path.getmtime(q)] + [os.path.getmtime(os.path.join(d, f)) for d, _, fs in os.walk(q) for f in fs])
        if time.time() - newest >= after:
            found.append(json.load(open(os.path.join(q, "question.json"))))
    return found


def answered(folder, question):
    """Marks a question answered here, so the watcher stops bringing it up."""
    q = os.path.join(folder, "answers", question)
    os.makedirs(q, exist_ok=True)
    open(os.path.join(q, "DONE"), "w").close()


def cmd_watch(args):
    vid = video_id(args.folder)
    left = stalled(args.folder)
    if left:
        for q in left:
            print("REMINDER: this question was claimed a while ago and still has no answer. Answer it now (chalkdust stream ... --done, "
                  "or release), or, only if it needs no answer, chalkdust note:")
            print(json.dumps(q, indent=1))
        return
    started = time.time()
    limit = float(os.environ.get("CHALKDUST_IDLE_MINUTES", 30)) * 60
    while True:
        try:
            reply = api("GET", f"/api/videos/{vid}/questions/next?timeout=25", timeout=60)
        except Unreachable:  # the service restarted or the network blinked: a watcher should outlast that
            time.sleep(5)
            continue
        questions = reply["questions"]
        if questions:
            break
        viewed = reply.get("viewed_seconds_ago")
        if min(time.time() - started, viewed if viewed is not None else float("inf")) > limit:
            print("Nobody has this video open, so the watcher stopped. Don't start it again unless the user comes back to it.")
            return
    for q in questions:
        q["answer_folder"] = os.path.abspath(os.path.join(args.folder, "answers", q["id"]))
        os.makedirs(os.path.join(q["answer_folder"], "scenes"), exist_ok=True)
        json.dump(q, open(os.path.join(q["answer_folder"], "question.json"), "w"), indent=1)
        print(json.dumps(q, indent=1))


def cmd_comments(args):
    print(json.dumps(api("GET", f"/api/videos/{video_id(args.folder)}/comments"), indent=1))


def cmd_delete(args):
    if not args.yes:
        sys.exit("This permanently deletes the video, its comments and answers from the service, and its links stop working. Add --yes once the user has confirmed.")
    api("DELETE", f"/api/videos/{video_id(args.folder)}")
    os.remove(os.path.join(args.folder, ".chalkdust.json"))
    print("Deleted. Your local files are untouched.")


def cmd_answer(args):
    vid = video_id(args.folder)
    folder = os.path.join(args.folder, "answers", args.question)
    api("POST", f"/api/videos/{vid}/questions/{args.question}/answer", read_sources(folder))
    route = f"/api/videos/{vid}/questions/{args.question}"
    status = wait_for_build(route + "/answer")
    report(status, save_stills(status, route + "/stills", folder))
    print(f"When the stills look right: chalkdust release {args.folder} {args.question}")


def print_warnings(warnings):
    for w in warnings:
        print("warning: " + w)


def stream_video_route(folder):
    """The video's own stream. Made the first time, with its links printed at once, so the user opens it while the next
    slides are written."""
    state_file = os.path.join(folder, ".chalkdust.json")
    if not os.path.exists(state_file):
        state = api("POST", "/api/videos/stream", {})
        fd = os.open(state_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)  # holds the owner link
        with os.fdopen(fd, "w") as f:
            json.dump(state, f)
        print("your link, which lets you ask questions:", state["owner_url"])
        print("link to share, watch only:", state["watch_url"])
    return f"/api/videos/{video_id(folder)}/stream"


def cmd_stream(args):
    if not args.question:
        folder, route, what = args.folder, stream_video_route(args.folder), "video"
    else:
        vid = video_id(args.folder)
        folder = os.path.join(args.folder, "answers", args.question)
        route, what = f"/api/videos/{vid}/questions/{args.question}/stream", "answer"
    try:
        if args.done:
            result = api("POST", route + "/done", {}, timeout=600)
            if args.question:
                answered(args.folder, args.question)
            print(f"done: the {what} is complete")
            print_warnings(result.get("warnings", []))
            return
        result = api("POST", route, read_sources(folder), timeout=300)
    except Unreachable as e:
        sys.exit(f"{e}\nThis may not have been published. Run the same command again: beats already published aren't added twice.")
    print(f"live: {result['live']}, beat {result['beat']}, in {result['seconds']:.1f}s")
    print_warnings(result.get("warnings", []))


def cmd_release(args):
    api("POST", f"/api/videos/{video_id(args.folder)}/questions/{args.question}/release", {})
    answered(args.folder, args.question)
    print("Released.")


def cmd_parts(args):
    wanted = {word.lower() for word in args.words}
    found = [(name, tags) for name, tags in PARTS.items() if wanted & set((name.replace("-", " ") + " " + tags).lower().split())]
    for name, tags in found:
        print(f"{name}: {tags}")
    if not found:
        print("Nothing for that. Use a plain shape, or write an inline <svg> in the scene.")


def cmd_map(args):
    """A map of a repo's real imports, as a cast for video.md: a Flow, each folder an area."""
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import repo_map
    m = repo_map.read(args.repo, args.most, args.tests)
    if not m["imports"]:
        sys.exit("No imports between the repo's own files were found.")
    print(repo_map.cast(m))


def cmd_note(args):
    api("POST", f"/api/videos/{video_id(args.folder)}/questions/{args.question}/note", {"text": args.text})
    answered(args.folder, args.question)
    print("Noted.")


def main_with(argv):
    ap = argparse.ArgumentParser(prog="chalkdust", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)
    p = sub.add_parser("login"); p.add_argument("key", nargs="?"); p.add_argument("--server", default=DEFAULT_SERVER); p.add_argument("--paste", action="store_true", help="type a key instead of connecting in the browser"); p.set_defaults(fn=cmd_login)
    for name, fn in (("publish", cmd_publish), ("watch", cmd_watch), ("comments", cmd_comments)):
        p = sub.add_parser(name); p.add_argument("folder"); p.set_defaults(fn=fn)
    for name, fn in (("answer", cmd_answer), ("release", cmd_release)):
        p = sub.add_parser(name); p.add_argument("folder"); p.add_argument("question"); p.set_defaults(fn=fn)
    p = sub.add_parser("stream"); p.add_argument("folder"); p.add_argument("question", nargs="?", help="an answer to stream; leave it out to stream the video itself")
    p.add_argument("--done", action="store_true", help="finish the video or the answer"); p.set_defaults(fn=cmd_stream)
    p = sub.add_parser("parts"); p.add_argument("words", nargs="+"); p.set_defaults(fn=cmd_parts)
    p = sub.add_parser("map", help="a cast of a repo's real imports, each folder an area"); p.add_argument("repo"); p.add_argument("--most", type=int, default=12); p.add_argument("--tests", action="store_true"); p.set_defaults(fn=cmd_map)
    p = sub.add_parser("delete"); p.add_argument("folder"); p.add_argument("--yes", action="store_true"); p.set_defaults(fn=cmd_delete)
    p = sub.add_parser("note"); p.add_argument("folder"); p.add_argument("question"); p.add_argument("text"); p.set_defaults(fn=cmd_note)
    args = ap.parse_args(argv)
    try:
        args.fn(args)
    except Unreachable as e:
        sys.exit(str(e))


def main():
    main_with(sys.argv[1:])


if __name__ == "__main__":
    main()
